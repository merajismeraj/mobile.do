# ---- Core ------------------------------------------------------------------
# Public URL of the studio (used for OAuth and payment redirects).
APP_URL=https://mobile-do.vercel.app
# Separate host that serves hosted apps (isolates them from the studio origin).
APPS_HOST=mobile-do-apps.vercel.app
# Allow fetching private/loopback hosts (e.g. local Ollama). Only when self-hosting.
ALLOW_PRIVATE_NETWORK=false

# ---- Supabase (Google sign-in + database) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cashfree subscriptions ----------------------------------------------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production
CASHFREE_ENV=sandbox

# ---- Custom domains (Vercel REST API) -----------------------------------------
VERCEL_TOKEN=
